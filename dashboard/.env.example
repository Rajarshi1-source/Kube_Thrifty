# Copy to `.env.local` for development. Every value here is validated at startup by lib/env.ts, so a
# malformed URL fails the boot rather than the first request.
#
# NOTE what is absent: there is no KUBECONFIG, no service-account token, no cluster API address. The
# dashboard holds NO cluster credentials. It cannot resize a pod because it has no mechanism to try.

# Host port 5433, not 5432: a native PostgreSQL commonly owns 5432, and pointing at it would connect
# successfully to entirely the wrong database. See docker-compose.yml (KT_DB_PORT).
DATABASE_URL=postgresql://kubethrifty:kubethrifty_dev_only@localhost:5433/kubethrifty
REDIS_URL=redis://localhost:6379
PROMETHEUS_URL=http://localhost:9090

CLUSTER_NAME=kubethrifty-demo

# Clamps applied to every proxied Prometheus query. These are ceilings, not defaults a client can
# raise: step=1s over 30d would ask Prometheus for ~2.6M points per series.
PROM_TIMEOUT_MS=8000
PROM_MAX_WINDOW_DAYS=30
PROM_MIN_STEP_SECONDS=30

DB_TIMEOUT_MS=5000

# Set to `false` to prove the app is still correct without a cache. It should only get slower.
CACHE_ENABLED=true
